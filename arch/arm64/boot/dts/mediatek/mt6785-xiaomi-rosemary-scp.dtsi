// SPDX-License-Identifier: GPL-2.0-only
/*
 * mt6785-xiaomi-rosemary-scp.dtsi -- the SCP (a Cortex-M4) of the Poco M5s.
 *
 * The SCP runs the sensor hub the four motion and environment sensors sit
 * behind, so this node is what makes them reachable at all.
 *
 * Addresses and sizes come from the phone's own tree [L: device-tree.dts:2975,
 * scp@10500000]: SRAM (TCM) at 0x10500000 with 0xc0000 bytes, cfg at
 * 0x105c0000, and the strobe of the clock block at 0x105c4000 which, on the
 * vendor tree, is a region of its own. mainline's mtk_scp addresses the clock
 * registers as cfg + 0x4000 (see MT8183_SCP_CLK_SW_SEL in
 * drivers/remoteproc/mtk_common.h), so cfg has to cover them: 0x5000, not the
 * vendor's 0x3000.
 *
 * The interrupt is GIC SPI 201, level high [L: same node,
 * interrupts = <0x00 0xc9 0x04>].
 *
 * The firmware is not loaded by the bootloader on this phone: the TCM reads
 * zero and every SRAM power-down register reads 0xffffffff, so the kernel
 * stages it. See tools/scp-repack.py for how the vendor's tinysys container
 * becomes the ELF this driver loads, and REPORT.md "sensors: the SCP under
 * mainline" for the whole story.
 */
/*
 * The board file still carries the vendor's inert placeholder for the SCP
 * (`scp { compatible = "mediatek,scp"; }`), which no mainline driver claims and
 * which has no registers: replace it with the node below.
 */
&{/} {
	/delete-node/ scp;
};

/ {
	reserved-memory {
		/*
		 * The carve-out the staged firmware lives in. mainline's
		 * mtk_scp allocates this region with dma_alloc_coherent() and
		 * translates firmware addresses through memory-region, so its
		 * address has to be pinned here: the segments of the repacked
		 * ELF carry absolute addresses inside it. 0x50000000 with 4 MiB
		 * is where the upstream MediaTek boards put theirs
		 * (mt8183-kukui.dtsi:96-100, mt8188-geralt.dtsi:167-170).
		 */
		scp_mem_reserved: scp-memory@50000000 {
			compatible = "shared-dma-pool";
			reg = <0 0x50000000 0 0x400000>;
			no-map;
		};
	};

	scp: scp@10500000 {
		compatible = "mediatek,mt6785-scp";
		reg = <0 0x10500000 0 0xc0000>,
		      <0 0x105c0000 0 0x5000>;
		reg-names = "sram", "cfg";
		interrupts = <GIC_SPI 201 IRQ_TYPE_LEVEL_HIGH>;
		memory-region = <&scp_mem_reserved>;
		firmware-name = "mediatek/mt6785/scp.img";
	};
};
